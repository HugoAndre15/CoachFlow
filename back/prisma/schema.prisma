generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Player {
    id            String        @id @default(uuid())
    first_name    String
    last_name     String
    created_at    DateTime      @default(now())
    jersey_number Int?
    team_id       String
    updated_at    DateTime      @updatedAt
    user_id       String?       @unique
    position      position?
    status        player_status @default(ACTIVE)
    strong_foot   strong_foot?
    matchEvents   MatchEvent[]
    team          Team          @relation(fields: [team_id], references: [id], onDelete: Cascade)
    user          User?         @relation(fields: [user_id], references: [id])
    matchPlayers  MatchPlayer[]
}

model Team {
    id         String     @id @default(uuid())
    name       String
    category   String
    created_at DateTime   @default(now())
    updated_at DateTime   @updatedAt
    club_id    String
    matches    Match[]
    players    Player[]
    club       Club       @relation(fields: [club_id], references: [id], onDelete: Cascade)
    teamUsers  TeamUser[]
}

model User {
    id            String     @id @default(uuid())
    email         String     @unique
    password_hash String
    first_name    String
    last_name     String
    created_at    DateTime   @default(now())
    updated_at    DateTime   @updatedAt
    clubUsers     ClubUser[]
    player        Player?
    teamUsers     TeamUser[]
}

model Club {
    id          String     @id @default(uuid())
    name        String
    created_at  DateTime   @default(now())
    updated_at  DateTime   @updatedAt
    city        String?
    invite_code String?    @unique
    logo        String?
    clubUsers   ClubUser[]
    teams       Team[]
}

model Match {
    id             String               @id @default(uuid())
    team_id        String
    opponent       String
    location       match_location
    match_date     DateTime
    status         match_status         @default(UPCOMING)
    created_at     DateTime             @default(now())
    updated_at     DateTime             @updatedAt
    team           Team                 @relation(fields: [team_id], references: [id], onDelete: Cascade)
    matchEvents    MatchEvent[]
    matchPlayers   MatchPlayer[]
    opponentEvents OpponentMatchEvent[]
}

model MatchPlayer {
    id         String              @id @default(uuid())
    match_id   String
    player_id  String
    status     match_player_status @default(SUBSTITUTE)
    created_at DateTime            @default(now())
    updated_at DateTime            @updatedAt
    match      Match               @relation(fields: [match_id], references: [id], onDelete: Cascade)
    player     Player              @relation(fields: [player_id], references: [id], onDelete: Cascade)

    @@unique([match_id, player_id])
    @@map("match_players")
}

model MatchEvent {
    id                String           @id @default(uuid())
    match_id          String
    player_id         String
    event_type        match_event_type
    minute            Int
    zone              field_zone?
    body_part         body_part?
    created_at        DateTime         @default(now())
    updated_at        DateTime         @updatedAt
    related_event_id  String?
    related_player_id String?
    match             Match            @relation(fields: [match_id], references: [id], onDelete: Cascade)
    player            Player           @relation(fields: [player_id], references: [id], onDelete: SetNull)
    relatedEvent      MatchEvent?      @relation("EventRelation", fields: [related_event_id], references: [id])
    relatedEvents     MatchEvent[]     @relation("EventRelation")
}

model OpponentMatchEvent {
    id            String              @id @default(uuid())
    match_id      String
    event_type    opponent_event_type
    minute        Int
    jersey_number String?
    created_at    DateTime            @default(now())
    match         Match               @relation(fields: [match_id], references: [id], onDelete: Cascade)

    @@map("opponent_match_events")
}

model ClubUser {
    id         String    @id @default(uuid())
    club_id    String
    user_id    String
    role       club_role
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    club       Club      @relation(fields: [club_id], references: [id], onDelete: Cascade)
    user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@unique([club_id, user_id])
}

model TeamUser {
    id         String    @id @default(uuid())
    team_id    String
    user_id    String
    role       team_role
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    team       Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
    user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@unique([team_id, user_id])
}

enum position {
    GOALKEEPER
    DEFENDER
    MIDFIELDER
    FORWARD
}

enum strong_foot {
    LEFT
    RIGHT
    BOTH
}

enum player_status {
    ACTIVE
    INJURED
    SUSPENDED
    RETIRED
}

enum match_location {
    HOME
    AWAY
}

enum match_status {
    UPCOMING
    LIVE
    FINISHED
}

enum match_event_type {
    GOAL
    ASSIST
    YELLOW_CARD
    RED_CARD
    RECOVERY
    BALL_LOSS
    SUBSTITUTION
}

enum field_zone {
    LEFT
    RIGHT
    AXIS
    BOX
    OUTSIDE
    DEF_LEFT
    DEF_CENTER
    DEF_RIGHT
    MID_LEFT
    MID_CENTER
    MID_RIGHT
    ATT_LEFT
    ATT_CENTER
    ATT_RIGHT
}

enum body_part {
    LEFT_FOOT
    RIGHT_FOOT
    HEAD
}

enum opponent_event_type {
    GOAL
    YELLOW_CARD
    RED_CARD
}

enum club_role {
    PRESIDENT
    RESPONSABLE
    COACH
}

enum team_role {
    COACH
    ASSISTANT_COACH
}

enum match_player_status {
    STARTER
    SUBSTITUTE
}
